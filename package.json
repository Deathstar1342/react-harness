{
  "name": "react-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "desktop:build": "npm run build && node scripts/desktop-build.mjs",
    "desktop:stage-runtime": "node scripts/stage-runtime.mjs",
    "desktop:start": "electron build/app/desktop/entry.cjs",
    "desktop:smoke": "node tests/desktop-smoke.ts",
    "package:prepare": "node scripts/prepare-desktop-package.mjs && node scripts/package-notices.mjs && node scripts/package-manifest.mjs build/bundled",
    "package:windows": "electron-builder --config packaging/electron-builder.cjs --win --x64 --publish never",
    "package:linux": "electron-builder --config packaging/electron-builder.cjs --linux --x64 --publish never",
    "start": "tsx server/index.ts",
    "profile:init": "tsx server/profile-cli.ts init",
    "profile:migrate": "tsx server/profile-cli.ts migrate",
    "typecheck": "tsc --noEmit && tsc -p desktop/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@monaco-editor/react": "^4.7.0",
    "diff": "^9.0.0",
    "dotenv": "^18.0.4",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "lucide-react": "^1.48.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "42.11.13",
    "electron-builder": "26.15.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
