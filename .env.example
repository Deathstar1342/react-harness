# Copy to .env in the checkout, or configure provider settings in the app.
# Keep the file private. Process environment variables override it.
STARK_BASE_URL=
STARK_API_KEY=

# Set all three model IDs to the exact text-only models offered by your provider.
ARCHITECT_MODEL=gemini-3.5-pro
CODER_MODEL=gemini-3.5-flash-withtools
CRITIC_MODEL=gemini-3.5-pro
MODEL_STREAMING=true

ARCHITECT_INPUT_TOKEN_LIMIT=128000
CODER_INPUT_TOKEN_LIMIT=128000
CRITIC_INPUT_TOKEN_LIMIT=128000
MODEL_MAX_OUTPUT_TOKENS=16384
REQUESTS_PER_MINUTE=60
TOKENS_PER_MINUTE=500000
TOKENS_PER_DAY=10000000

HOST=127.0.0.1
PORT=3000
APPROVAL_MODE=balanced
# Application state lives in .harness/ in this checkout.
# HARNESS_WORKSPACE_ROOT=/absolute/path/to/projects

# Optional role guidance, up to 32000 UTF-8 bytes per file.
# Relative paths resolve from the checkout for values set here.
# ARCHITECT_PROMPT_FILE=prompts/architect.md
# CODER_PROMPT_FILE=prompts/coder.md
# CRITIC_PROMPT_FILE=prompts/critic.md
