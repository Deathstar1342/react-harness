# Backend configuration. Keep real credentials only in your local .env.
# Include the provider's API prefix, for example /v1, in the base URL.
STARK_BASE_URL=https://your-provider.example/v1
STARK_API_KEY=

ARCHITECT_MODEL=gemini-3.1-pro-preview
CODER_MODEL=gemini-3.8-flash
CRITIC_MODEL=gemini-3.6-flash

# JSON in ordinary streamed assistant text, without native tool parameters.
TOOL_PROTOCOL=json
MODEL_STREAMING=true

# Published model limits; configurable independently from working context budgets.
ARCHITECT_INPUT_TOKEN_LIMIT=1048576
CODER_INPUT_TOKEN_LIMIT=1048576
CRITIC_INPUT_TOKEN_LIMIT=1048576
MODEL_MAX_OUTPUT_TOKENS=16384

# Shared account scheduler settings. Coder delegation is currently serial.
REQUESTS_PER_MINUTE=120
TOKENS_PER_MINUTE=1500000
TOKENS_PER_DAY=150000000

# Local browser application, with execution inside WSL.
HOST=127.0.0.1
PORT=3000
APPROVAL_MODE=balanced
HARNESS_DATA_DIR=.harness

# Optional initial folder for new projects; Settings can override it locally.
# HARNESS_WORKSPACE_ROOT=/home/you/React Harness Projects


