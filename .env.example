# Reference for profile/config/.env under the selected HARNESS_HOME.
# Run npm run profile:init first; edit its printed path. Do not replace existing settings.
# Keep HARNESS_INIT/LEGACY_ROOT/MIGRATION_RETRY/SELECT_DATA/LAUNCH_KEY out of this file.
# Include the provider's API prefix, for example /v1, in the base URL.
STARK_BASE_URL=https://your-provider.example/v1
STARK_API_KEY=

ARCHITECT_MODEL=gemini-3.5-pro
CODER_MODEL=gemini-3.5-flash-withtools
CRITIC_MODEL=gemini-3.5-pro

# Native Chat Completions tools. Candidate IDs above are not live verified.
# No legacy protocol fallback. Backend transport only, not an ordinary UI toggle.
MODEL_STREAMING=true

# Conservative application budgets, NOT verified provider limits (unknown).
ARCHITECT_INPUT_TOKEN_LIMIT=128000
CODER_INPUT_TOKEN_LIMIT=128000
CRITIC_INPUT_TOKEN_LIMIT=128000
MODEL_MAX_OUTPUT_TOKENS=16384

# Shared account scheduler settings. Coder delegation is currently serial.
REQUESTS_PER_MINUTE=60
TOKENS_PER_MINUTE=500000
TOKENS_PER_DAY=10000000

# Local browser application, with execution inside WSL.
HOST=127.0.0.1
PORT=3000
APPROVAL_MODE=balanced
# Optional absolute override; omitted uses HARNESS_HOME/profile/state.
# HARNESS_DATA_DIR=/home/you/private-harness-state

# Optional initial folder for new projects; Settings can override it locally.
# HARNESS_WORKSPACE_ROOT=/home/you/React Harness Projects

# Optional UTF-8 role guidance, appended to the native role instructions (32000 bytes max).
# Use absolute paths, or paths relative to profile/config; restart after changes.
# ARCHITECT_PROMPT_FILE=.harness/prompts/architect.md
# CODER_PROMPT_FILE=.harness/prompts/coder.md
# CRITIC_PROMPT_FILE=.harness/prompts/critic.md
